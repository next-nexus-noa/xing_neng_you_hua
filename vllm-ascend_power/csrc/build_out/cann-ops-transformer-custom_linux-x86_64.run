sig_key=

initargs="$@"

while [ -n "$*" ]
do
    case "$1" in
    -h | --help)
	MS_Help
	exit 0
	;;
    -q | --quiet)
	quiet=y
	noprogress=y
	shift
	;;
    --info)
	echo Identification: "$label"
	echo Target directory: "$targetdir"
	echo Uncompressed size: 1860 KB
	echo Compression: gzip
	if test x"n" != x""; then
	    echo Encryption: n
	fi
	echo Date of packaging: Wed Jun  3 15:37:30 UTC 2026
	echo Built with Makeself version 2.5.0
	echo Build command was: "/vllm-workspace/vllm-ascend/csrc/third_party/makeself/makeself.sh \\
    \"--header\" \\
    \"/vllm-workspace/vllm-ascend/csrc/third_party/makeself/makeself-header.sh\" \\
    \"--help-header\" \\
    \"./help.info\" \\
    \"--tar-format\" \\
    \"posix\" \\
    \"--gzip\" \\
    \"--complevel\" \\
    \"4\" \\
    \"--nomd5\" \\
    \"--sha256\" \\
    \"./\" \\
    \"cann-ops-transformer-custom_linux-x86_64.run\" \\
    \"version:1.0\" \\
    \"./install.sh\""
